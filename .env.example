# Use demo mode to explore the full interface without external services.
DEMO_MODE=true
CLOUD_MODE=false

# Model provider: openai or nebius.
MODEL_PROVIDER=openai

# Required when MODEL_PROVIDER=openai and DEMO_MODE=false.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=high

# Required when MODEL_PROVIDER=nebius and DEMO_MODE=false.
# The default model is an NVIDIA Nemotron model served by Nebius Token Factory.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Optional Tavily grounding for the Nebius text path.
# Enable only with MODEL_PROVIDER=nebius and provide a server-side Tavily key.
TAVILY_GROUNDING_ENABLED=false
TAVILY_API_KEY=

# Required by the Docker backend when CLOUD_MODE=true.
LEANBRIDGE_BACKEND_TOKEN=

# Point this at a Lean 4/Lake project that contains the desired mathlib version.
LEAN_PROJECT_PATH=
LEAN_COMMAND=lean
LAKE_COMMAND=lake
LEAN_TIMEOUT_MS=30000
MAX_REPAIR_ATTEMPTS=3
PORT=4310
