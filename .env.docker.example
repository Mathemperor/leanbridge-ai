MODEL_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Optional bonus integration: Tavily mathlib grounding for the Nebius text path.
TAVILY_GROUNDING_ENABLED=false
TAVILY_API_KEY=

# OpenAI remains available as an alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=high

LEANBRIDGE_BACKEND_TOKEN=
# Separate 16-256 character password for invited browser users (not an API key).
LEANBRIDGE_ACCESS_PASSWORD=
MAX_REPAIR_ATTEMPTS=3
LEAN_TIMEOUT_MS=30000
PORT=4310
